}
function renderTag(){
  const m = curModel(), [lo,hi] = dpBounds(m);
  $("tagcard").innerHTML = `<div class="row" style="justify-content:space-between;flex-wrap:nowrap;align-items:flex-start">
      <div class="name grow">${esc(m.n)}</div>
      <button type="button" class="btn sm" data-open="1" aria-expanded="${pickerOpen}">${pickerOpen? "Tutup" : "Ganti tipe"}</button></div>
