let filter = "Semua", editingId = null, waLeadId = null;
const FILTERS = ["Semua","Hari ini","Prospek","Hot","Test Ride","Closing"];
function isDue(l){ return l.fu && l.fu <= today() && l.status!=="Closing" && l.status!=="Batal"; }
function matchFilter(l){
  if(filter==="Semua") return true;
  if(filter==="Hari ini") return isDue(l);
  return l.status===filter;
}
function renderFilters(){
  const due = leads.filter(isDue).length;
  $("lfilter").innerHTML = FILTERS.map(f => `<button type="button" class="chip" data-f="${f}" aria-pressed="${f===filter}">${f}${f==="Hari ini" && due? ` <b>${due}</b>`:""}</button>`).join("");
  const b = $("lbadge"); b.hidden = !due; b.textContent = due;
}
function leadCard(l, sample){
  const m = modelByName(l.model);
  let est = "";
  if(m && l.tipe==="Kredit"){ const r = instAt(m, l.dp||0, l.tenor||35, settings.useCut); if(r) est = ` · ${l.tenor||35} bln ≈ ${rp(r.final)}`; }
  let fu = "";
  if(l.fu){
    const cls = l.fu < today() ? "late" : l.fu === today() ? "today" : "";
    const txt = l.fu < today() ? "Terlambat · "+fmtDate(l.fu) : l.fu === today() ? "Follow-up hari ini" : "Follow-up "+fmtDate(l.fu);
    fu = `<span class="pill ${cls}">${txt}</span>`;
  }
  const sc = slug(l.status);
  return `<article class="card lead ${sample?"sample":""}" ${sample?"":`data-id="${l.id}"`}>
    ${sample?`<div class="ex">Contoh tampilan</div>`:""}
    <div class="head"><div class="grow"><div class="nm">${esc(l.nama||"Tanpa nama")}</div>
      <div class="line">${esc(l.model||"-")}${l.tipe==="Cash"?" · Cash": (l.dp? " · DP "+rp(l.dp):"")}${est}</div></div>
      <span class="pill ${sc}">${esc(l.status)}</span></div>
    <div class="row">${fu}${l.sumber?`<span class="pill">${esc(l.sumber)}</span>`:""}</div>
    ${l.cat?`<div class="line">${esc(l.cat)}</div>`:""}
    ${sample?"":`<div class="actions">
      <button type="button" class="btn wa sm" data-act="wa" data-id="${l.id}">WhatsApp</button>
      <button type="button" class="btn sm" data-act="edit" data-id="${l.id}">Ubah</button>
      <button type="button" class="btn sm" data-act="done" data-id="${l.id}">Follow-up +3 hari</button></div>`}
  </article>`;
}
function renderLeads(){
  renderFilters();
  const q = $("lsearch").value.trim().toLowerCase(), qd = digits(q);
