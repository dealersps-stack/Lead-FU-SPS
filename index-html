  if(!leads.length){
    box.innerHTML = `<div class="card empty"><b>Belum ada lead</b><div class="muted small">Catat calon pembeli dari chat, telepon, atau showroom. Tekan "+ Lead baru", atau hitung simulasi di tab Kalkulator lalu tekan "Simpan jadi lead".</div></div>` +
      leadCard({nama:"Budi",model:"Beat eSP CBS",dp:2100000,tenor:35,tipe:"Kredit",sumber:"Meta Ads",status:"Prospek",fu:today(),cat:"Tanya angsuran 35 bulan, warna hitam"}, true);
  } else if(!list.length){
    box.innerHTML = `<div class="card empty"><b>Tidak ada hasil</b><div class="muted small">Ubah filter atau kata pencarian.</div></div>`;
