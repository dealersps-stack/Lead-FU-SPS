      <div><small>Potongan max</small><b>${m.p? rp(m.p) : "-"}</b></div>
    </div>`;
  $("dprange").textContent = "DP di tabel: " + rp(lo) + " sampai " + rp(hi) + ", kelipatan Rp100.000.";
}
function renderDpChips(){
  const m = curModel(), [lo,hi] = dpBounds(m);
  const picks = [lo, 2000000, 2500000, 3000000, 4000000, 5000000].filter(v => v>=lo && v<=hi);
  const uniq = [...new Set(picks)];
  const cur = rowFor(m, calc.dp)[0]*1000;
  $("dpchips").innerHTML = uniq.map(v => `<button type="button" class="chip" data-dp="${v}" aria-pressed="${v===cur}">${(v/1e6).toLocaleString("id-ID")} jt</button>`).join("");
}
function renderSched(){
  const m = curModel(); const row = rowFor(m, calc.dp);
  const use = settings.useCut;
  $("sched").innerHTML = TEN.map((t,i) => {
    const r = instAt(m, calc.dp, t, use);
    const total = r.dp + r.final*t;
    const cutLine = r.cut ? `<div class="cut">−${rp(r.cut)} <s>${rp(r.base)}</s></div>` : "";
    return `<div class="r"><div class="ten">${t}<small>bulan</small></div>
      <div class="amt"><div class="big">${rp(r.final)}</div>${cutLine}<div class="sub">total ${rp(total)}</div></div></div>`;
  }).join("");
}
function renderDp(){
  const m = curModel(), [lo,hi] = dpBounds(m);
  const row = rowFor(m, calc.dp);
  const shown = row[0]*1000;
  const note = $("dpnote");
  if(calc.dp !== shown){
    note.hidden = false;
    note.textContent = calc.dp < lo ? "DP di bawah minimum. Dihitung dengan DP "+rp(lo)+"."
      : calc.dp > hi ? "DP di atas rentang tabel. Dihitung dengan DP "+rp(hi)+"."
      : "DP dibulatkan ke "+rp(shown)+" (tabel memakai kelipatan Rp100.000).";
  } else note.hidden = true;
}
function renderCalc(syncInput){
  const m = curModel(); const row = rowFor(m, calc.dp);
  if(syncInput) $("dp").value = Math.round(calc.dp).toLocaleString("id-ID");
  renderPicker(); renderTag(); renderDp(); renderDpChips(); renderSched();
  $("cut").checked = settings.useCut;
  $("cutlbl").textContent = "Pengurang tenor 11 & 23 (−" + Math.round(settings.cut/1000) + " rb)";
}
function setModel(n){
  calc.model = n; const m = curModel(), [lo,hi] = dpBounds(m);
  calc.dp = Math.min(Math.max(calc.dp, lo), hi);
  pickerOpen = false; $("pickcard").hidden = true; $("q").value = "";
  renderCalc(true);
}
function waText(m, dp, tenor){
  const r = instAt(m, dp, tenor, settings.useCut);
  const d = settings.dealer ? settings.dealer : "dealer kami";
  return `Halo Kak, berikut simulasi kredit ${m.n} dari ${d}:\n\nHarga OTR: ${rp(m.o)}\nDP: ${rp(r.dp)}\nAngsuran tenor ${tenor} bulan: ${rp(r.final)}/bulan\n\nEstimasi, dapat berubah sesuai ketentuan leasing. S&K berlaku.\nBoleh tahu rencana beli cash atau kredit, Kak?`;
}

