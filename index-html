  });
  $("lform").addEventListener("submit", submitForm);
  $("f-cancel").addEventListener("click", closeForm);
  $("f-dp").addEventListener("blur", () => { const v = +digits($("f-dp").value); $("f-dp").value = v? v.toLocaleString("id-ID") : ""; });
  $("f-del").addEventListener("click", () => {
    if(!delArmed){ delArmed = true; $("f-del").textContent = "Tekan lagi untuk menghapus"; return; }
    leads = leads.filter(x => x.id !== editingId); saveLeads(); closeForm(); renderLeads(); toast("Lead dihapus");
  });
  $("sh-lead").addEventListener("click", e => { if(e.target.id==="sh-lead") closeForm(); });
  $("sh-wa").addEventListener("click", e => { if(e.target.id==="sh-wa") $("sh-wa").hidden = true; });
  $("wa-close").addEventListener("click", () => $("sh-wa").hidden = true);
  $("wa-list").addEventListener("click", e => { const b = e.target.closest("[data-i]"); if(b) sendWa(+b.dataset.i); });

  $("s-cut").addEventListener("input", () => { settings.cut = +digits($("s-cut").value)||0; saveSettings(); renderSched(); $("cutlbl").textContent = "Pengurang tenor 11 & 23 (−" + Math.round(settings.cut/1000) + " rb)"; });
  $("s-cut").addEventListener("blur", () => { $("s-cut").value = Math.round(settings.cut).toLocaleString("id-ID"); });
  $("s-dealer").addEventListener("input", () => { settings.dealer = $("s-dealer").value.trim(); saveSettings(); });
  $("s-sales").addEventListener("input", () => { settings.sales = $("s-sales").value.trim(); saveSettings(); });
  $("b-csv").addEventListener("click", () => leads.length ? copyText(leadsCsv(), "CSV disalin. Tempel ke Excel atau catatan.") : toast("Belum ada lead"));
  $("b-json").addEventListener("click", () => leads.length ? copyText(JSON.stringify({v:1, leads}), "Cadangan disalin") : toast("Belum ada lead"));
  let wipeArmed = false;
  $("b-restore").addEventListener("click", () => {
    try{
      const o = JSON.parse($("b-text").value.trim());
      if(!o || !Array.isArray(o.leads)) throw 0;
      const ids = new Set(leads.map(l=>l.id)); let n = 0;
      o.leads.forEach(l => { if(l && !ids.has(l.id)){ leads.push(l); n++; } });
      saveLeads(); renderLeads(); $("b-text").value=""; toast(n+" lead dipulihkan");
    }catch(e){ toast("Teks cadangan tidak valid"); }
