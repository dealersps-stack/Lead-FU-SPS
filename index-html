  $("addlead").addEventListener("click", () => openForm(null));
  $("lfilter").addEventListener("click", e => { const b = e.target.closest("[data-f]"); if(b){ filter = b.dataset.f; renderLeads(); } });
  $("lsearch").addEventListener("input", renderLeads);
  $("llist").addEventListener("click", e => {
