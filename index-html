<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0d1b3d">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Leads SPS">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}[hidden]{display:none!important}</style>
<title>Kalkulator Leads SPS</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
/* Layout: aplikasi satu kolom ala HP. Bilah judul menempel di atas, tiga tab di bawah (Kalkulator, Leads, Info). */
:root{
  --bg:#eef1f6; --surface:#ffffff; --ink:#0d1b3d; --muted:#56637f; --line:#d3daea; --soft:#e5eaf5;
  --bar:#0d1b3d; --bar-ink:#ffffff; --accent:#cf2128; --accent-ink:#ffffff;
  --good:#0f7a57; --warn:#a45f00; --crit:#c0262d; --info:#2456c7;
  --good-bg:#dff3ea; --warn-bg:#fdecd0; --crit-bg:#fbe0e1; --info-bg:#e1eafb;
  --f-display:'Barlow Condensed','Arial Narrow',sans-serif;
  --f-body:'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --f-num:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;
  --shadow:0 1px 2px rgba(13,27,61,.08),0 4px 14px rgba(13,27,61,.06);
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#0a1228; --surface:#121c3a; --ink:#eef2fb; --muted:#9facc9; --line:#27345c; --soft:#1a2750;
  --bar:#0e1731; --bar-ink:#ffffff; --accent:#ff6064; --accent-ink:#1d0709;
  --good:#53d4a1; --warn:#f2b45a; --crit:#ff8a8e; --info:#8fb0ff;
  --good-bg:#12392e; --warn-bg:#40300f; --crit-bg:#451a1d; --info-bg:#1b2c5c;
  --shadow:0 1px 2px rgba(0,0,0,.4); color-scheme:dark; } }
:root[data-theme="dark"]{
  --bg:#0a1228; --surface:#121c3a; --ink:#eef2fb; --muted:#9facc9; --line:#27345c; --soft:#1a2750;
  --bar:#0e1731; --bar-ink:#ffffff; --accent:#ff6064; --accent-ink:#1d0709;
  --good:#53d4a1; --warn:#f2b45a; --crit:#ff8a8e; --info:#8fb0ff;
  --good-bg:#12392e; --warn-bg:#40300f; --crit-bg:#451a1d; --info-bg:#1b2c5c;
  --shadow:0 1px 2px rgba(0,0,0,.4); color-scheme:dark; }

*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.45;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--info);outline-offset:2px}
.app{display:flex;flex-direction:column;height:100%;max-width:600px;margin:0 auto;background:var(--bg)}
header.top{flex:none;background:var(--bar);color:var(--bar-ink);padding:10px 16px;display:flex;align-items:center;gap:12px;border-bottom:3px solid var(--accent)}
header.top .logo{width:34px;height:34px;border-radius:8px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-family:var(--f-display);font-weight:700;font-size:20px;flex:none}
header.top h1{margin:0;font-family:var(--f-display);font-weight:700;font-size:22px;letter-spacing:.02em;line-height:1.05;text-transform:uppercase}
header.top small{display:block;font-family:var(--f-body);font-weight:400;font-size:12px;letter-spacing:0;text-transform:none;opacity:.8}
main{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:16px;display:flex;flex-direction:column;gap:14px}
nav.tabs{flex:none;display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface);border-top:1px solid var(--line)}
nav.tabs button{border:0;background:none;padding:10px 4px 9px;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:12.5px;font-weight:500;color:var(--muted);position:relative}
nav.tabs button svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav.tabs button[aria-selected="true"]{color:var(--accent)}
nav.tabs button[aria-selected="true"]::before{content:'';position:absolute;top:-1px;left:25%;right:25%;height:3px;background:var(--accent);border-radius:0 0 3px 3px}
nav.tabs .badge{position:absolute;top:5px;left:calc(50% + 8px);min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--accent);color:var(--accent-ink);font-size:11px;font-weight:600;display:grid;place-items:center}
section.panel[hidden]{display:none!important}
section.panel{display:flex;flex-direction:column;gap:14px;min-width:0}

h2{margin:0;font-family:var(--f-display);font-weight:700;font-size:15px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px;box-shadow:var(--shadow);min-width:0}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;min-width:0}
.grow{flex:1;min-width:0}
.muted{color:var(--muted)}
.small{font-size:13px}
.num{font-family:var(--f-num);font-variant-numeric:tabular-nums;font-weight:500}
label.f{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--muted);font-weight:500;min-width:0}
input[type=text],input[type=search],input[type=tel],input[type=number],input[type=date],select,textarea{width:100%;min-height:46px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font-size:16px}
textarea{min-height:76px;resize:vertical}
.btn{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;min-height:46px;padding:0 14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;font-size:15px}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.wa{background:var(--good);color:#fff;border-color:var(--good)}
:root[data-theme="dark"] .btn.wa{color:#04281c}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .btn.wa{color:#04281c}}
.btn.ghost{background:transparent}
.btn.danger{color:var(--crit);border-color:var(--crit)}
.btn.sm{min-height:38px;padding:0 12px;font-size:14px}
.btn[disabled]{opacity:.5}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btns.one{grid-template-columns:1fr}

/* picker model */
.picker-list{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-height:236px;overflow-y:auto;padding:2px;margin-top:10px}
.pick{border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:8px 10px;text-align:left;min-width:0;display:flex;flex-direction:column;gap:1px}
.pick b{font-family:var(--f-display);font-size:18px;line-height:1.05;text-transform:uppercase;font-weight:700;overflow-wrap:anywhere}
.pick span{font-family:var(--f-num);font-size:12px;color:var(--muted)}
.pick[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.pick[aria-pressed="true"] span{color:var(--bg);opacity:.8}

/* label harga */
.tag{display:flex;flex-direction:column;gap:6px}
.tag .name{font-family:var(--f-display);font-weight:700;font-size:30px;line-height:1;text-transform:uppercase;overflow-wrap:anywhere}
.tag .meta{display:flex;gap:18px;flex-wrap:wrap}
.tag .meta div{display:flex;flex-direction:column}
.tag .meta small{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.tag .meta b{font-family:var(--f-num);font-size:17px;font-weight:600;font-variant-numeric:tabular-nums}

.dp{display:grid;grid-template-columns:52px 1fr 52px;gap:8px}
.dp button{font-size:24px;font-weight:600;border-radius:10px;border:1px solid var(--line);background:var(--surface)}
.dp input{text-align:center;font-family:var(--f-num);font-size:20px;font-weight:600}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;min-height:36px;padding:0 13px;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}

/* tabel angsuran */
.sched{display:flex;flex-direction:column}
.sched .r{display:grid;grid-template-columns:64px 1fr;gap:10px;padding:11px 0;border-top:1px solid var(--line);align-items:center}
.sched .r:first-child{border-top:0}
.sched .ten{font-family:var(--f-display);font-weight:700;font-size:26px;line-height:1}
.sched .ten small{display:block;font-family:var(--f-body);font-size:11px;font-weight:500;color:var(--muted);letter-spacing:.04em}
.sched .amt{text-align:right;min-width:0}
.sched .amt .big{font-family:var(--f-num);font-weight:600;font-size:21px;font-variant-numeric:tabular-nums}
.sched .amt .sub{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.sched .amt .cut{font-size:12px;color:var(--good);font-weight:600}
.sched .amt s{color:var(--muted)}
.notice{border-radius:10px;padding:10px 12px;font-size:14px;background:var(--warn-bg);color:var(--warn)}
.switch{display:flex;align-items:center;gap:10px;font-size:14px}
.switch input{width:22px;height:22px;accent-color:var(--accent)}

/* leads */
.lead{display:flex;flex-direction:column;gap:8px}
.lead .head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.lead .nm{font-weight:600;font-size:17px;overflow-wrap:anywhere}
.pill{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;font-size:12px;font-weight:600;background:var(--soft);color:var(--muted);white-space:nowrap}
.pill.prospek,.pill.testride{background:var(--info-bg);color:var(--info)}
.pill.hot{background:var(--warn-bg);color:var(--warn)}
.pill.closing{background:var(--good-bg);color:var(--good)}
.pill.late{background:var(--crit-bg);color:var(--crit)}
.pill.today{background:var(--warn-bg);color:var(--warn)}
.lead .line{font-size:14px;color:var(--muted);overflow-wrap:anywhere}
.lead .actions{display:flex;gap:8px;flex-wrap:wrap}
.empty{text-align:center;padding:22px 12px;display:flex;flex-direction:column;gap:10px;align-items:center}
.empty b{font-family:var(--f-display);font-size:22px;text-transform:uppercase}
.sample{opacity:.75;border-style:dashed}
.sample .ex{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--muted)}

/* sheet */
.sheet-wrap{position:fixed;inset:0;background:rgba(5,10,25,.55);z-index:20;display:flex;align-items:flex-end;justify-content:center}
.sheet-wrap[hidden]{display:none!important}
.sheet{background:var(--surface);color:var(--ink);width:100%;max-width:600px;max-height:92%;overflow-y:auto;border-radius:16px 16px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:12px}
.sheet h3{margin:0;font-family:var(--f-display);font-size:24px;text-transform:uppercase;font-weight:700}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tpl{display:flex;flex-direction:column;gap:2px;text-align:left;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:10px 12px;width:100%}
.tpl b{font-size:15px}
.tpl span{font-size:13px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.toast{position:fixed;left:50%;bottom:calc(76px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px;font-size:14px;font-weight:500;z-index:30;max-width:calc(100% - 32px);text-align:center}
.toast[hidden]{display:none!important}
.tbl{width:100%;border-collapse:collapse;font-size:14px}
.tbl th,.tbl td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums}
.tbl th:first-child,.tbl td:first-child{text-align:left}
.tbl th{font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:600}
.scrollx{overflow-x:auto}
ol.steps{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;font-size:14.5px}
textarea.code{font-family:var(--f-num);font-size:13px}
@media (max-width:380px){.grid2{grid-template-columns:1fr}.picker-list{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>


</head>
<body>
<div class="app" id="app">
  <header class="top">
    <div class="logo" aria-hidden="true">S</div>
    <h1>Kalkulator Leads SPS<small>Estimasi angsuran, catat calon pembeli</small></h1>
  </header>

  <main id="main">
    <!-- ============ KALKULATOR ============ -->
    <section class="panel" id="p-calc" aria-label="Kalkulator angsuran">
      <div class="card" id="pickcard" hidden>
        <label class="f" for="q">Cari tipe motor
          <input id="q" type="search" placeholder="Ketik: beat, vario, scoopy…" autocomplete="off">
        </label>
        <div class="picker-list" id="plist" role="list"></div>
      </div>

      <div class="card tag" id="tagcard"></div>

      <div class="card" style="display:flex;flex-direction:column;gap:10px">
        <h2>Uang muka (DP)</h2>
        <div class="dp">
          <button type="button" id="dpm" aria-label="Kurangi DP Rp100.000">−</button>
          <input id="dp" type="text" inputmode="numeric" aria-label="DP dalam rupiah" autocomplete="off">
          <button type="button" id="dpp" aria-label="Tambah DP Rp100.000">+</button>
        </div>
        <div class="chips" id="dpchips" role="group" aria-label="DP cepat"></div>
        <div class="small muted" id="dprange"></div>
        <div class="notice" id="dpnote" hidden></div>
      </div>

      <div class="card" style="display:flex;flex-direction:column;gap:6px">
        <div class="row" style="justify-content:space-between">
          <h2>Angsuran per bulan</h2>
          <label class="switch"><input type="checkbox" id="cut"><span id="cutlbl">Pengurang tenor 11 &amp; 23</span></label>
        </div>
        <div class="sched" id="sched"></div>
        <div class="small muted">Estimasi, dapat berubah sesuai ketentuan leasing. S&amp;K berlaku.</div>
      </div>

      <div class="btns">
        <button class="btn wa" type="button" id="sendwa">Kirim ke WhatsApp</button>
        <button class="btn primary" type="button" id="tolead">Simpan jadi lead</button>
      </div>
    </section>

    <!-- ============ LEADS ============ -->
    <section class="panel" id="p-leads" aria-label="Catatan leads" hidden>
      <div class="row">
        <button class="btn primary grow" type="button" id="addlead">+ Lead baru</button>
      </div>
      <div class="chips" id="lfilter" role="group" aria-label="Filter lead"></div>
      <input id="lsearch" type="search" placeholder="Cari nama atau nomor" autocomplete="off" aria-label="Cari lead">
      <div id="llist" style="display:flex;flex-direction:column;gap:10px"></div>
    </section>

    <!-- ============ INFO ============ -->
    <section class="panel" id="p-info" aria-label="Info dan pengaturan" hidden>
      <div class="card" style="display:flex;flex-direction:column;gap:12px">
        <h2>Pengaturan</h2>
        <label class="f" for="s-cut">Pengurang angsuran tenor 11 &amp; 23 (Rp per bulan)
          <input id="s-cut" type="text" inputmode="numeric" autocomplete="off">
        </label>
        <label class="f" for="s-dealer">Nama dealer (untuk pesan WhatsApp)
          <input id="s-dealer" type="text" placeholder="mis. SPS Motor" autocomplete="off">
        </label>
        <label class="f" for="s-sales">Nama sales
          <input id="s-sales" type="text" placeholder="mis. Andi" autocomplete="off">
        </label>
        <div class="small muted">Pengurang diambil dari potongan atas PL Reguler MD. Tersimpan di HP ini.</div>
      </div>

      <div class="card" style="display:flex;flex-direction:column;gap:10px">
        <h2>Cadangan data lead</h2>
        <div class="small muted">Lead hanya tersimpan di HP ini. Salin cadangan secara berkala dan simpan ke WhatsApp atau catatan Anda sendiri.</div>
        <div class="btns">
          <button class="btn" type="button" id="b-csv">Salin CSV</button>
          <button class="btn" type="button" id="b-json">Salin cadangan</button>
        </div>
        <label class="f" for="b-text">Pulihkan dari cadangan (tempel di sini)
          <textarea id="b-text" class="code" placeholder='Tempel teks cadangan, lalu tekan "Pulihkan"'></textarea>
        </label>
        <div class="btns">
          <button class="btn" type="button" id="b-restore">Pulihkan</button>
          <button class="btn danger" type="button" id="b-wipe">Hapus semua lead</button>
        </div>
      </div>

      <div class="card" style="display:flex;flex-direction:column;gap:10px">
        <h2>Potongan max per series</h2>
        <div class="scrollx"><table class="tbl" id="t-series"></table></div>
        <div class="small muted">*Potongan atas PL Reguler MD.</div>
      </div>

      <div class="card" style="display:flex;flex-direction:column;gap:10px">
        <h2>Subsidi PO</h2>
        <div class="scrollx"><table class="tbl" id="t-po"></table></div>
        <div class="small muted">Bayar = DP PO − Subs. Arti kolom Cash dan baris 8% mengikuti tabel sumber.</div>
      </div>

      <div class="card" style="display:flex;flex-direction:column;gap:8px">
        <h2>Pasang di HP</h2>
        <ol class="steps">
          <li>Buka alamat aplikasi ini di Chrome.</li>
          <li>Ketuk titik tiga di pojok kanan atas.</li>
          <li>Pilih <b>Instal aplikasi</b> atau <b>Tambahkan ke layar utama</b>.</li>
          <li>Ikon muncul di layar utama dan bisa dibuka tanpa internet.</li>
        </ol>
      </div>

      <div class="card" style="display:flex;flex-direction:column;gap:6px">
        <h2>Catatan data</h2>
        <div class="small muted" id="datanote"></div>
      </div>
    </section>
  </main>

  <nav class="tabs" role="tablist" aria-label="Menu utama">
    <button type="button" role="tab" id="t-calc" aria-selected="true" data-tab="calc">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h2M12 12h2M16 12h0M8 16h2M12 16h2M16 16h0"/></svg>Kalkulator</button>
    <button type="button" role="tab" id="t-leads" aria-selected="false" data-tab="leads">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5M16 5a3.5 3.5 0 0 1 0 6.5M18.5 14.8c1.7.7 2.7 2.4 3 5.2"/></svg>Leads<span class="badge" id="lbadge" hidden>0</span></button>
    <button type="button" role="tab" id="t-info" aria-selected="false" data-tab="info">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8h0"/></svg>Info</button>
  </nav>
</div>

<!-- form lead -->
<div class="sheet-wrap" id="sh-lead" hidden>
  <form class="sheet" id="lform" aria-labelledby="lform-title" novalidate>
    <h3 id="lform-title">Lead baru</h3>
    <div class="grid2">
      <label class="f" for="f-nama">Nama<input id="f-nama" type="text" autocomplete="off"></label>
      <label class="f" for="f-wa">No WhatsApp<input id="f-wa" type="tel" inputmode="tel" placeholder="0812…" autocomplete="off"></label>
    </div>
    <label class="f" for="f-model">Model minat<select id="f-model"></select></label>
    <div class="grid2">
      <label class="f" for="f-dp">DP (Rp)<input id="f-dp" type="text" inputmode="numeric" autocomplete="off"></label>
      <label class="f" for="f-tenor">Tenor (bulan)<select id="f-tenor"></select></label>
    </div>
    <div class="grid2">
      <label class="f" for="f-tipe">Pembayaran<select id="f-tipe"><option>Kredit</option><option>Cash</option></select></label>
      <label class="f" for="f-sumber">Sumber<select id="f-sumber"></select></label>
    </div>
    <div class="grid2">
      <label class="f" for="f-status">Status<select id="f-status"></select></label>
      <label class="f" for="f-fu">Follow-up berikutnya<input id="f-fu" type="date"></label>
    </div>
    <label class="f" for="f-cat">Catatan<textarea id="f-cat" placeholder="mis. minta angsuran 35 bulan, warna hitam"></textarea></label>
    <div class="notice" id="f-err" hidden></div>
    <div class="btns">
      <button class="btn ghost" type="button" id="f-cancel">Batal</button>
      <button class="btn primary" type="submit">Simpan</button>
    </div>
    <button class="btn danger" type="button" id="f-del" hidden>Hapus lead ini</button>
  </form>
</div>

<!-- pilih template WA -->
