const calc = { model: MODELS[0].n, dp: 2500000 };
let pickerOpen = false;
function setPicker(open){ pickerOpen = open; $("pickcard").hidden = !open; renderTag(); if(open){ renderPicker(); setTimeout(()=>$("q").focus(), 30); } }
function curModel(){ return modelByName(calc.model) || MODELS[0]; }

function renderPicker(){
